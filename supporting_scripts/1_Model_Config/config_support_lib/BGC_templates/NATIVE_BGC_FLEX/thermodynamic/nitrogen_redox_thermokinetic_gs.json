                "10": "O2_DEGASSING",
                "11": "VOLATILIZATION",
                "12": "PLANT_UPTAKE_NO3-N",
                "13": "PLANT_UPTAKE_NH4-N"
            },
            "1": {
                "_NAME": "DECOMPOSITION_DOC",
                "_DESCRIPTION": "Soil organic matter -> DOC (zero order per unit soil water, temperature dependent)",
                "CONSUMED": "NONE",
                "PRODUCED": "DOC",
                "KINETICS": [
                    "k_dec*theta_T^((Tsoil_K-T_K0)-T_ref)*max(Vw_m3,eps_V)",
                    "1/day"
                ],
                "PARAMETER_NAMES": [
                    "eps_V",
                    "T_K0",
                    "T_ref",
                    "theta_T",
                    "k_dec"
                ]
            },
            "2": {
                "_NAME": "DECOMPOSITION_NH4",
                "_DESCRIPTION": "Soil organic matter -> NH4-N, at the C:N ratio CN_dom of the decomposed matter",
                "CONSUMED": "NONE",
                "PRODUCED": "NH4-N",
                "KINETICS": [
                    "(k_dec/CN_dom)*theta_T^((Tsoil_K-T_K0)-T_ref)*max(Vw_m3,eps_V)",
                    "1/day"
                ],
                "PARAMETER_NAMES": [
                    "eps_V",
                    "T_K0",
                    "T_ref",
                    "theta_T",
                    "CN_dom",
                    "k_dec"
                ]
            },
            "3": {
                "_NAME": "RESPIRATION_DOC",
                "_DESCRIPTION": "Aerobic respiration CH2O + O2 -> CO2 + H2O: DOC consumed",
                "CONSUMED": "DOC",
                "PRODUCED": "CO2_loss",
                "KINETICS": [
                    "k_resp*((DOC/max(Vw_m3,eps_V))/(K_DOC+(DOC/max(Vw_m3,eps_V))))*((DO/max(Vw_m3,eps_V))/(K_O2_resp+(DO/max(Vw_m3,eps_V))))*max(0,1-exp((dG0_resp+R_kJ*Tsoil_K*(log(c_CO2_M)-log(max((DOC/max(Vw_m3,eps_V))/MW_C,eps_c))-log(max((DO/max(Vw_m3,eps_V))/MW_O2,eps_c)))+m_ATP*dG_ATP)/(chi*R_kJ*Tsoil_K)))*theta_T^((Tsoil_K-T_K0)-T_ref)*max(Vw_m3,eps_V)",
                    "1/day"
                ],
                "PARAMETER_NAMES": [
                    "eps_V",
                    "eps_c",
                    "T_K0",
                    "T_ref",
                    "theta_T",
                    "R_kJ",
                    "dG_ATP",
                    "m_ATP",
                    "chi",
                    "c_CO2_M",
                    "MW_C",
                    "MW_O2",
                    "dG0_resp",
                    "k_resp",
                    "K_DOC",
                    "K_O2_resp"
                ]
            },
            "4": {
                "_NAME": "RESPIRATION_O2",
                "_DESCRIPTION": "Aerobic respiration: O2 consumed (32/12 g O2 per g C)",
                "CONSUMED": "DO",
                "PRODUCED": "NONE",
                "KINETICS": [
                    "2.666666667*k_resp*((DOC/max(Vw_m3,eps_V))/(K_DOC+(DOC/max(Vw_m3,eps_V))))*((DO/max(Vw_m3,eps_V))/(K_O2_resp+(DO/max(Vw_m3,eps_V))))*max(0,1-exp((dG0_resp+R_kJ*Tsoil_K*(log(c_CO2_M)-log(max((DOC/max(Vw_m3,eps_V))/MW_C,eps_c))-log(max((DO/max(Vw_m3,eps_V))/MW_O2,eps_c)))+m_ATP*dG_ATP)/(chi*R_kJ*Tsoil_K)))*theta_T^((Tsoil_K-T_K0)-T_ref)*max(Vw_m3,eps_V)",
                    "1/day"
                ],
                "PARAMETER_NAMES": [
                    "eps_V",
                    "eps_c",
                    "T_K0",
                    "T_ref",
                    "theta_T",
                    "R_kJ",
                    "dG_ATP",
                    "m_ATP",
                    "chi",
                    "c_CO2_M",
                    "MW_C",
                    "MW_O2",
                    "dG0_resp",
                    "k_resp",
                    "K_DOC",
                    "K_O2_resp"
                ]
            },
            "5": {
                "_NAME": "NITRIFICATION_NH4",
                "_DESCRIPTION": "Nitrification NH4+ + 2 O2 -> NO3- + 2 H+ + H2O",
                "CONSUMED": "NH4-N",
                "PRODUCED": "NO3-N",
                "KINETICS": [
                    "k_nit*((NH4-N/max(Vw_m3,eps_V))/(K_NH4+(NH4-N/max(Vw_m3,eps_V))))*((DO/max(Vw_m3,eps_V))/(K_O2_nit+(DO/max(Vw_m3,eps_V))))*max(0,1-exp((dG0_nit+R_kJ*Tsoil_K*(log(max((NO3-N/max(Vw_m3,eps_V))/MW_N,eps_c))+2*log((10^(-pH_w)))-log(max((NH4-N/max(Vw_m3,eps_V))/MW_N,eps_c))-2*log(max((DO/max(Vw_m3,eps_V))/MW_O2,eps_c)))+m_ATP*dG_ATP)/(chi*R_kJ*Tsoil_K)))*theta_T^((Tsoil_K-T_K0)-T_ref)*max(Vw_m3,eps_V)",
                    "1/day"
                ],
                "PARAMETER_NAMES": [
                    "eps_V",
                    "eps_c",
                    "T_K0",
                    "T_ref",
                    "theta_T",
                    "R_kJ",
                    "dG_ATP",
                    "m_ATP",
                    "chi",
                    "pH_w",
                    "MW_N",
                    "MW_O2",
                    "dG0_nit",
                    "K_NH4",
                    "K_O2_nit",
                    "k_nit"
                ]
            },
            "6": {
                "_NAME": "NITRIFICATION_O2",
                "_DESCRIPTION": "Nitrification: O2 consumed (64/14 g O2 per g N)",
                "CONSUMED": "DO",
                "PRODUCED": "NONE",
                "KINETICS": [
                    "4.571428571*k_nit*((NH4-N/max(Vw_m3,eps_V))/(K_NH4+(NH4-N/max(Vw_m3,eps_V))))*((DO/max(Vw_m3,eps_V))/(K_O2_nit+(DO/max(Vw_m3,eps_V))))*max(0,1-exp((dG0_nit+R_kJ*Tsoil_K*(log(max((NO3-N/max(Vw_m3,eps_V))/MW_N,eps_c))+2*log((10^(-pH_w)))-log(max((NH4-N/max(Vw_m3,eps_V))/MW_N,eps_c))-2*log(max((DO/max(Vw_m3,eps_V))/MW_O2,eps_c)))+m_ATP*dG_ATP)/(chi*R_kJ*Tsoil_K)))*theta_T^((Tsoil_K-T_K0)-T_ref)*max(Vw_m3,eps_V)",
                    "1/day"
                ],
                "PARAMETER_NAMES": [
                    "eps_V",
                    "eps_c",
                    "T_K0",
                    "T_ref",
                    "theta_T",
                    "R_kJ",
                    "dG_ATP",
                    "m_ATP",
                    "chi",
                    "pH_w",
                    "MW_N",
                    "MW_O2",
                    "dG0_nit",
                    "K_NH4",
                    "K_O2_nit",
                    "k_nit"
                ]
            },
            "7": {
                "_NAME": "DENITRIFICATION_NO3",
                "_DESCRIPTION": "Denitrification 5/4 CH2O + NO3- + H+ -> 1/2 N2 + 5/4 CO2 + 7/4 H2O",
                "CONSUMED": "NO3-N",
                "PRODUCED": "N2_loss",
                "KINETICS": [
                    "k_den*((NO3-N/max(Vw_m3,eps_V))/(K_NO3+(NO3-N/max(Vw_m3,eps_V))))*((DOC/max(Vw_m3,eps_V))/(K_DOC+(DOC/max(Vw_m3,eps_V))))*(K_I_O2/(K_I_O2+(DO/max(Vw_m3,eps_V))))*max(0,1-exp((dG0_den+R_kJ*Tsoil_K*(0.5*log(c_N2_M)+1.25*log(c_CO2_M)-1.25*log(max((DOC/max(Vw_m3,eps_V))/MW_C,eps_c))-log(max((NO3-N/max(Vw_m3,eps_V))/MW_N,eps_c))-log((10^(-pH_w))))+m_ATP*dG_ATP)/(chi*R_kJ*Tsoil_K)))*theta_T^((Tsoil_K-T_K0)-T_ref)*max(Vw_m3,eps_V)",
                    "1/day"
                ],
                "PARAMETER_NAMES": [
                    "eps_V",
                    "eps_c",
                    "T_K0",
                    "T_ref",
                    "theta_T",
                    "R_kJ",
                    "dG_ATP",
                    "m_ATP",
                    "chi",
                    "pH_w",
                    "c_CO2_M",
                    "c_N2_M",
                    "MW_N",
                    "MW_C",
                    "dG0_den",
                    "K_DOC",
                    "K_NO3",
                    "K_I_O2",
                    "k_den"
                ]
            },
            "8": {
                "_NAME": "DENITRIFICATION_DOC",
                "_DESCRIPTION": "Denitrification: DOC consumed (15/14 g C per g N)",
                "CONSUMED": "DOC",
                "PRODUCED": "CO2_loss",
                "KINETICS": [
                    "1.071428571*k_den*((NO3-N/max(Vw_m3,eps_V))/(K_NO3+(NO3-N/max(Vw_m3,eps_V))))*((DOC/max(Vw_m3,eps_V))/(K_DOC+(DOC/max(Vw_m3,eps_V))))*(K_I_O2/(K_I_O2+(DO/max(Vw_m3,eps_V))))*max(0,1-exp((dG0_den+R_kJ*Tsoil_K*(0.5*log(c_N2_M)+1.25*log(c_CO2_M)-1.25*log(max((DOC/max(Vw_m3,eps_V))/MW_C,eps_c))-log(max((NO3-N/max(Vw_m3,eps_V))/MW_N,eps_c))-log((10^(-pH_w))))+m_ATP*dG_ATP)/(chi*R_kJ*Tsoil_K)))*theta_T^((Tsoil_K-T_K0)-T_ref)*max(Vw_m3,eps_V)",
                    "1/day"
                ],
                "PARAMETER_NAMES": [
                    "eps_V",
                    "eps_c",
                    "T_K0",
                    "T_ref",
                    "theta_T",
                    "R_kJ",
                    "dG_ATP",
                    "m_ATP",
                    "chi",
                    "pH_w",
                    "c_CO2_M",
                    "c_N2_M",
                    "MW_N",
                    "MW_C",
                    "dG0_den",
                    "K_DOC",
                    "K_NO3",
                    "K_I_O2",
                    "k_den"
                ]
            },
            "9": {
                "_NAME": "O2_EXCHANGE",
                "_DESCRIPTION": "O2 supply from the soil atmosphere, first order towards saturation (Benson and Krause 1984, temperature capped at 0 C)",
                "CONSUMED": "NONE",
                "PRODUCED": "DO",
                "KINETICS": [
                    "k_o2*max(exp(bk0+bk1/max(Tsoil_K,T_K0)+bk2/max(Tsoil_K,T_K0)^2+bk3/max(Tsoil_K,T_K0)^3+bk4/max(Tsoil_K,T_K0)^4)-(DO/max(Vw_m3,eps_V)),0)*max(Vw_m3,eps_V)",
                    "1/day"
                ],
                "PARAMETER_NAMES": [
                    "eps_V",
                    "T_K0",
                    "bk0",
                    "bk1",
                    "bk2",
                    "bk3",
                    "bk4",
                    "k_o2"
                ]
            },
            "10": {
                "_NAME": "O2_DEGASSING",
                "_DESCRIPTION": "O2 loss to the soil atmosphere when supersaturated (same coefficient)",
                "CONSUMED": "DO",
                "PRODUCED": "NONE",
                "KINETICS": [
                    "k_o2*max((DO/max(Vw_m3,eps_V))-exp(bk0+bk1/max(Tsoil_K,T_K0)+bk2/max(Tsoil_K,T_K0)^2+bk3/max(Tsoil_K,T_K0)^3+bk4/max(Tsoil_K,T_K0)^4),0)*max(Vw_m3,eps_V)",
                    "1/day"
                ],
                "PARAMETER_NAMES": [
                    "eps_V",
                    "T_K0",
                    "bk0",
                    "bk1",
                    "bk2",
                    "bk3",
                    "bk4",
                    "k_o2"
                ]
            },
            "11": {
                "_NAME": "VOLATILIZATION",
                "_DESCRIPTION": "As in the reaction network (RN)",
                "CONSUMED": "NH4-N",
                "PRODUCED": "NH3_loss",
                "KINETICS": [
                    "k_vol * gamma_tmp * NH4-N * depth_factor",
                    "1/day"
                ],
                "PARAMETER_NAMES": [
                    "k_vol",
                    "depth_factor",
                    "gamma_tmp"
                ]
            },
            "12": {
                "_NAME": "PLANT_UPTAKE_NO3-N",
                "_DESCRIPTION": "Plant uptake, first order, growing-season heat-unit response f=clip((T-T_base_pu)/(T_opt_pu-T_base_pu),0,1) (same in RN, RN-T and EQ)",
                "CONSUMED": "NO3-N",
                "PRODUCED": "PLANT_N",
                "KINETICS": [
                    "k_pu*max(0,min(1,((max(Tsoil_K,T_K0)-T_K0)-T_base_pu)/(T_opt_pu-T_base_pu)))*NO3-N",
                    "1/day"
                ],
                "PARAMETER_NAMES": [
                    "T_K0",
                    "T_base_pu",
                    "T_opt_pu",
                    "k_pu"
                ]
            },
            "13": {
                "_NAME": "PLANT_UPTAKE_NH4-N",
                "_DESCRIPTION": "Plant uptake, first order, growing-season heat-unit response f=clip((T-T_base_pu)/(T_opt_pu-T_base_pu),0,1) (same in RN, RN-T and EQ)",
                "CONSUMED": "NH4-N",
                "PRODUCED": "PLANT_N",
                "KINETICS": [
                    "k_pu*max(0,min(1,((max(Tsoil_K,T_K0)-T_K0)-T_base_pu)/(T_opt_pu-T_base_pu)))*NH4-N",
                    "1/day"
                ],
                "PARAMETER_NAMES": [
                    "T_K0",
                    "T_base_pu",
                    "T_opt_pu",
                    "k_pu"
                ]
            }
        },
