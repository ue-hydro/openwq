        }
    },
    "CYCLING_FRAMEWORKS": {
        "RNT_SOIL": {
            "_DESCRIPTION": "Soil water: decomposition, aerobic respiration, nitrification, denitrification, O2 supply, volatilization and uptake",
            "LIST_TRANSFORMATIONS": {
                "1": "DECOMPOSITION_DOC",
                "2": "DECOMPOSITION_NH4",
                "3": "RESPIRATION_DOC",
                "4": "RESPIRATION_O2",
